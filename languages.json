{
    "python": {
        "rules": [
            {
                "pattern": "^//\\s*(.*)$",
                "replacement": "# \\1",
                "description": "Comment"
            },
            {
                "pattern": "^out\\s+(.*)$",
                "replacement": "print(\"\\1\")",
                "description": "Output statement"
            },
            {
                "pattern": "^var\\s+([a-zA-Z_][a-zA-Z0-9_]*)\\s*=\\s*(.*)$",
                "replacement": "\\1 = \\2",
                "description": "Variable assignment"
            },
            {
                "pattern": "^fn\\s+([a-zA-Z_][a-zA-Z0-9_]*)(?:\\s+(.*))?$",
                "replacement": "def \\1(\\2):",
                "format_args": true,
                "description": "Function definition"
            },
            {
                "pattern": "^class\\s+([a-zA-Z_][a-zA-Z0-9_]*)(?:\\s+([a-zA-Z_][a-zA-Z0-9_]*))?$",
                "replacement": "class \\1(\\2):",
                "description": "Class definition"
            },
            {
                "pattern": "^loop\\s+(\\d+|[a-zA-Z_][a-zA-Z0-9_]*)$",
                "replacement": "for i in range(\\1):",
                "description": "Simple loop"
            },
            {
                "pattern": "^if\\s+(.*)$",
                "replacement": "if \\1:",
                "description": "If statement"
            },
            {
                "pattern": "^else\\s*if\\s+(.*)$",
                "replacement": "elif \\1:",
                "description": "Else if statement"
            },
            {
                "pattern": "^else$",
                "replacement": "else:",
                "description": "Else statement"
            },
            {
                "pattern": "^try$",
                "replacement": "try:",
                "description": "Try block"
            },
            {
                "pattern": "^catch\\s+([a-zA-Z_][a-zA-Z0-9_]*)$",
                "replacement": "except Exception as \\1:",
                "description": "Catch block"
            },
            {
                "pattern": "^finally$",
                "replacement": "finally:",
                "description": "Finally block"
            },
            {
                "pattern": "^import\\s+(.*)$",
                "replacement": "import \\1",
                "description": "Import module"
            },
            {
                "pattern": "^from\\s+([a-zA-Z_][a-zA-Z0-9_\\.]*)\\s+import\\s+(.*)$",
                "replacement": "from \\1 import \\2",
                "description": "From import"
            },
            {
                "pattern": "^ret\\s*(.*)$",
                "replacement": "return \\1",
                "description": "Return statement"
            }
        ]
    }
}
